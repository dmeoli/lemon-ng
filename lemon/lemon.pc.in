prefix=${pcfiledir}/../..
exec_prefix=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: @PROJECT_NAME@
Description: Library for Efficient Modeling and Optimization in Networks
Version: @PROJECT_VERSION@
Libs: -L${libdir} -l@LEMON_PC_LIB@ @GLPK_LIBS@ @CPLEX_LIBS@ @SOPLEX_LIBS@ @CLP_LIBS@ @CBC_LIBS@
Cflags: -I${includedir}
