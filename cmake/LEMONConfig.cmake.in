# The CMake configuration of an installed LEMON, found where it is installed:
#
#   find_package(LEMON CONFIG REQUIRED)
#   target_link_libraries(main PRIVATE LEMON::lemon)
#
# LEMON_INCLUDE_DIRS and LEMON_LIBRARIES are also set, for the projects that
# use the variables instead of the target.

INCLUDE(${CMAKE_CURRENT_LIST_DIR}/LEMONTargets.cmake)

GET_TARGET_PROPERTY(LEMON_INCLUDE_DIR LEMON::lemon
  INTERFACE_INCLUDE_DIRECTORIES)
SET(LEMON_INCLUDE_DIRS "${LEMON_INCLUDE_DIR}")
SET(LEMON_LIBRARY LEMON::lemon)
SET(LEMON_LIBRARIES LEMON::lemon)
SET(LEMON_VERSION "@LEMON_VERSION@")
